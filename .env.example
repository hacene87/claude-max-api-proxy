# Claude Max API Proxy - configuration
# Copy to .env for local runs. In a container platform (EasyPanel, Compose,
# ...) set these as service environment variables instead.

# ------------------------------------------------------------------
# Proxy API key (OpenAI style bearer token). Every request except
# /health needs:  Authorization: Bearer <key>
#
# Leave unset to use a random key generated on first start and saved
# (mode 0600) to PROXY_API_KEY_FILE - it is never printed to the logs.
# "off" disables auth entirely (local development ONLY).
# ------------------------------------------------------------------
# PROXY_API_KEY=
# PROXY_API_KEY_FILE=~/.claude-max-api-proxy/api-key

# ------------------------------------------------------------------
# Admin key for /admin/* (relogin flow). A separate key is recommended
# so regular API users can't trigger a relogin. Falls back to the
# proxy API key when unset.
# ------------------------------------------------------------------
# PROXY_ADMIN_KEY=

# Port to listen on (default: 3456)
PORT=3456

# Bind address:
#   127.0.0.1  = local only (default)
#   0.0.0.0    = all interfaces (required inside a Docker container)
HOST=127.0.0.1

# ------------------------------------------------------------------
# Browser access. By default no web origin may call the proxy (CORS)
# and, when bound to 127.0.0.1, only localhost Host headers are
# accepted (blocks DNS rebinding). Comma-separated lists.
# ------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:8080
# ALLOWED_HOSTS=localhost,127.0.0.1,proxy.example.com   ("*" disables the check)

# ------------------------------------------------------------------
# Claude CLI tool access. The CLI runs with permission prompts
# skipped, so anyone holding the API key can have it run any enabled
# tool (Bash included) as this user. Restrict it when clients don't
# need an agent: "" = no tools, or a list like "Read,WebSearch"
# (vision needs Read). Unset = all tools (needed by OpenClaw).
# Requests with an OpenAI "tools" array always get no built-in tools.
# ------------------------------------------------------------------
# CLAUDE_TOOLS=Read,WebSearch,WebFetch
# Working directory for the CLI (default: the server's cwd)
# CLAUDE_WORKDIR=/path/to/sandbox

# Allow image_url downloads from private/LAN/loopback addresses
# (blocked by default to prevent SSRF)
# ALLOW_PRIVATE_IMAGE_URLS=true

# Debug logging (logs request bodies)
# DEBUG=1
